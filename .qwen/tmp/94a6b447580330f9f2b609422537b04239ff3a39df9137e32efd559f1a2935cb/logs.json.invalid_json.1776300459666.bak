    "message": "# 🚀 SparkleClean Pro - Phase : API Contracts, Migrations & Service Layer## Enterprise Cleaning Platform | Australia-Optimized | Agentic Architecture> **Applied Reasoning Framework**: DFS for endpoint dependency resolution • Tree of Thoughts for API design patterns • Graph of Thoughts for event flow mapping • MCTS for rate-limiting strategies • OASIS-IS for agent API governance • Chain of Thoughts for implementation sequencing---## 📐 PHASE  SCOPE```✅ Deliverables:├── API Contract Specifications (OpenAPI .)├── Prisma Migration Scripts + Seed Data├── Service Layer Implementation (NestJS Modules)├── Authentication & RBAC Flows├── Booking Engine API Endpoints├── Geo Service APIs with PostGIS Queries├── AI/RAG Service Integration Points├── Webhook & Event-Driven Architecture├── Rate Limiting, Caching & Observability└── Australia Compliance Layer (Privacy Act, GST)🎯 Success Criteria:• All endpoints documented in OpenAPI with examples• Database migrations idempotent and reversible• Service layer 9%+ test coverage• RBAC enforced at resolver level• Geo queries <ms P95 for suburb lookups• AI agent calls gated by OASIS-IS policies• Webhooks retry with exponential backoff• GDPR/Privacy Act compliant data handling```---## 🗄️ . PRISMA MIGRATIONS & SEED DATA### Migration: `645_init_schema.prisma````prisma-- CreatePostgisExtensionCREATE EXTENSION IF NOT EXISTS postgis;-- CreateEnum: Role, UserStatus, PropertyType, etc.-- (All enums from Phase  schema)-- CreateTable: UserCREATE TABLE \"User\" (    \"id\" TEXT NOT NULL,    \"email\" TEXT NOT NULL,    \"phone\" TEXT,    \"firstName\" TEXT NOT NULL,    \"lastName\" TEXT NOT NULL,    \"avatarUrl\" TEXT,    \"role\" \"Role\" NOT NULL DEFAULT 'CUSTOMER',    \"status\" \"UserStatus\" NOT NULL DEFAULT 'ACTIVE',    \"preferences\" JSONB,    \"metadata\" JSONB,    \"createdAt\" TIMESTAMP() NOT NULL DEFAULT CURRENT_TIMESTAMP,    \"updatedAt\" TIMESTAMP() NOT NULL,    \"lastLoginAt\" TIMESTAMP(),    CONSTRAINT \"User_pkey\" PRIMARY KEY (\"id\"));-- CreateIndex: UserCREATE UNIQUE INDEX \"User_email_key\" ON \"User\"(\"email\");CREATE UNIQUE INDEX \"User_phone_key\" ON \"User\"(\"phone\");CREATE INDEX \"User_email_idx\" ON \"User\"(\"email\");CREATE INDEX \"User_role_status_idx\" ON \"User\"(\"role\", \"status\");-- CreateTable: Property (with PostGIS)CREATE TABLE \"Property\" (    \"id\" TEXT NOT NULL,    \"customerId\" TEXT NOT NULL,    \"addressLine\" TEXT NOT NULL,    \"addressLine\" TEXT,    \"suburb\" VARCHAR() NOT NULL,    \"state\" VARCHAR() NOT NULL,    \"postcode\" VARCHAR(4) NOT NULL,    \"country\" TEXT NOT NULL DEFAULT 'AU',    \"location\" geometry(Point, 46),    \"propertyType\" \"PropertyType\" NOT NULL,    \"bedrooms\" INTEGER NOT NULL,    \"bathrooms\" INTEGER NOT NULL,    \"parkingSpaces\" INTEGER,    \"totalAreaSqm\" DOUBLE PRECISION,    \"floorCount\" INTEGER,    \"hasPool\" BOOLEAN NOT NULL DEFAULT false,    \"hasPets\" BOOLEAN NOT NULL DEFAULT false,    \"accessNotes\" TEXT,    \"gateCode\" TEXT,    \"parkingNotes\" TEXT,    \"createdAt\" TIMESTAMP() NOT NULL DEFAULT CURRENT_TIMESTAMP,    \"updatedAt\" TIMESTAMP() NOT NULL,    CONSTRAINT \"Property_pkey\" PRIMARY KEY (\"id\"));-- CreateIndex: PropertyCREATE INDEX \"Property_suburb_state_postcode_idx\" ON \"Property\"(\"suburb\", \"state\", \"postcode\");CREATE INDEX \"Property_location_idx\" ON \"Property\" USING GIST (\"location\");-- CreateTable: Suburb (with PostGIS polygon)CREATE TABLE \"Suburb\" (    \"id\" TEXT NOT NULL,    \"name\" VARCHAR() NOT NULL,    \"state\" VARCHAR() NOT NULL,    \"postcode\" VARCHAR(4) NOT NULL,    \"boundary\" geometry(Polygon, 46),    \"centroid\" geometry(Point, 46),    \"slug\" TEXT NOT NULL,    \"metaTitle\" TEXT,    \"metaDescription\" TEXT,    \"seoContent\" TEXT,    \"searchVolume\" INTEGER,    \"competitionScore\" DOUBLE PRECISION,    \"createdAt\" TIMESTAMP() NOT NULL DEFAULT CURRENT_TIMESTAMP,    \"updatedAt\" TIMESTAMP() NOT NULL,    CONSTRAINT \"Suburb_pkey\" PRIMARY KEY (\"id\"));-\n\n# 🚀 SparkleClean Pro - Phase : API Contracts, Migrations & Service Layer## Enterprise Cleaning Platform | Australia-Optimized | Agentic Architecture> **Applied Reasoning Framework**: DFS for endpoint dependency resolution • Tree of Thoughts for API design patterns • Graph of Thoughts for event flow mapping • MCTS for rate-limiting strategies • OASIS-IS for agent API governance • Chain of Thoughts for implementation sequencing---## 📐 PHASE  SCOPE```✅ Deliverables:├── API Contract Specifications (OpenAPI .)├── Prisma Migration Scripts + Seed Data├── Service Layer Implementation (NestJS Modules)├── Authentication & RBAC Flows├── Booking Engine API Endpoints├── Geo Service APIs with PostGIS Queries├── AI/RAG Service Integration Points├── Webhook & Event-Driven Architecture├── Rate Limiting, Caching & Observability└── Australia Compliance Layer (Privacy Act, GST)🎯 Success Criteria:• All endpoints documented in OpenAPI with examples• Database migrations idempotent and reversible• Service layer 9%+ test coverage• RBAC enforced at resolver level• Geo queries <ms P95 for suburb lookups• AI agent calls gated by OASIS-IS policies• Webhooks retry with exponential backoff• GDPR/Privacy Act compliant data handling```---## 🗄️ . PRISMA MIGRATIONS & SEED DATA### Migration: `645_init_schema.prisma````prisma-- CreatePostgisExtensionCREATE EXTENSION IF NOT EXISTS postgis;-- CreateEnum: Role, UserStatus, PropertyType, etc.-- (All enums from Phase  schema)-- CreateTable: UserCREATE TABLE \"User\" (    \"id\" TEXT NOT NULL,    \"email\" TEXT NOT NULL,    \"phone\" TEXT,    \"firstName\" TEXT NOT NULL,    \"lastName\" TEXT NOT NULL,    \"avatarUrl\" TEXT,    \"role\" \"Role\" NOT NULL DEFAULT 'CUSTOMER',    \"status\" \"UserStatus\" NOT NULL DEFAULT 'ACTIVE',    \"preferences\" JSONB,    \"metadata\" JSONB,    \"createdAt\" TIMESTAMP() NOT NULL DEFAULT CURRENT_TIMESTAMP,    \"updatedAt\" TIMESTAMP() NOT NULL,    \"lastLoginAt\" TIMESTAMP(),    CONSTRAINT \"User_pkey\" PRIMARY KEY (\"id\"));-- CreateIndex: UserCREATE UNIQUE INDEX \"User_email_key\" ON \"User\"(\"email\");CREATE UNIQUE INDEX \"User_phone_key\" ON \"User\"(\"phone\");CREATE INDEX \"User_email_idx\" ON \"User\"(\"email\");CREATE INDEX \"User_role_status_idx\" ON \"User\"(\"role\", \"status\");-- CreateTable: Property (with PostGIS)CREATE TABLE \"Property\" (    \"id\" TEXT NOT NULL,    \"customerId\" TEXT NOT NULL,    \"addressLine\" TEXT NOT NULL,    \"addressLine\" TEXT,    \"suburb\" VARCHAR() NOT NULL,    \"state\" VARCHAR() NOT NULL,    \"postcode\" VARCHAR(4) NOT NULL,    \"country\" TEXT NOT NULL DEFAULT 'AU',    \"location\" geometry(Point, 46),    \"propertyType\" \"PropertyType\" NOT NULL,    \"bedrooms\" INTEGER NOT NULL,    \"bathrooms\" INTEGER NOT NULL,    \"parkingSpaces\" INTEGER,    \"totalAreaSqm\" DOUBLE PRECISION,    \"floorCount\" INTEGER,    \"hasPool\" BOOLEAN NOT NULL DEFAULT false,    \"hasPets\" BOOLEAN NOT NULL DEFAULT false,    \"accessNotes\" TEXT,    \"gateCode\" TEXT,    \"parkingNotes\" TEXT,    \"createdAt\" TIMESTAMP() NOT NULL DEFAULT CURRENT_TIMESTAMP,    \"updatedAt\" TIMESTAMP() NOT NULL,    CONSTRAINT \"Property_pkey\" PRIMARY KEY (\"id\"));-- CreateIndex: PropertyCREATE INDEX \"Property_suburb_state_postcode_idx\" ON \"Property\"(\"suburb\", \"state\", \"postcode\");CREATE INDEX \"Property_location_idx\" ON \"Property\" USING GIST (\"location\");-- CreateTable: Suburb (with PostGIS polygon)CREATE TABLE \"Suburb\" (    \"id\" TEXT NOT NULL,    \"name\" VARCHAR() NOT NULL,    \"state\" VARCHAR() NOT NULL,    \"postcode\" VARCHAR(4) NOT NULL,    \"boundary\" geometry(Polygon, 46),    \"centroid\" geometry(Point, 46),    \"slug\" TEXT NOT NULL,    \"metaTitle\" TEXT,    \"metaDescription\" TEXT,    \"seoContent\" TEXT,    \"searchVolume\" INTEGER,    \"competitionScore\" DOUBLE PRECISION,    \"createdAt\" TIMESTAMP() NOT NULL DEFAULT CURRENT_TIMESTAMP,    \"updatedAt\" TIMESTAMP() NOT NULL,    CONSTRAINT \"Suburb_pkey\" PRIMARY KEY (\"id\"))